{
  "name": "ofry",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "convex": "^1.48.0",
      "better-auth": "1.6.17",
      "@convex-dev/better-auth": "^0.12.5",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev -F @ofry/backend --",
    "dev:setup": "turbo run dev:setup -F @ofry/backend --",
    "deploy": "turbo run deploy -F @ofry/infra --",
    "destroy": "turbo run destroy -F @ofry/infra --",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@ofry/config": "workspace:*",
    "@types/node": "^26.4.1",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
